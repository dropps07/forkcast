GEMINI_API_KEY= your_gemini_api_key_here
# Web Search mode only. Tavily is used whenever TAVILY_API_KEY is set.
TAVILY_API_KEY= your_tavily_api_key_here
# Without a Tavily key, Web Search falls back to Keenable (docs.keenable.ai):
# KEENABLE_API_KEY uses the keyed endpoints; otherwise the keyless endpoints
# are used by default (rate limited per IP). Set KEENABLE_KEYLESS=false to
# opt out. Keyed and keyless requests are both logged under Keenable's
# default data policy (docs.keenable.ai/data-privacy).
# KEENABLE_API_KEY=
# KEENABLE_KEYLESS=false
PORT=3001